{
  "name": "@cinebridge/api",
  "version": "1.0.0",
  "private": true,
  "description": "cinebridge-api: recomendação e orquestração de equipes, ponto de entrada da plataforma",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "container": "npm run db:preparar && npm start",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gerar": "prisma generate",
    "db:preparar": "prisma migrate deploy"
  },
  "dependencies": {
    "@cinebridge/comum": "1.0.0",
    "@fastify/compress": "9.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "fastify": "^5.12.7",
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  }
}
