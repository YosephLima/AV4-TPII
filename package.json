{
  "name": "cinebridge",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma cinebridge em microsserviços containerizados (AV4)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "pacotes/comum",
    "servicos/api",
    "servicos/profissionais",
    "servicos/projetos",
    "servicos/notificacoes"
  ],
  "scripts": {
    "postinstall": "npm run gerar --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
