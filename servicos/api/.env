# cinebridge-api. Os nomes de host são os serviços do docker-compose, resolvidos na rede cinebridge-net.
PORT=3000
DATABASE_URL=postgresql://cinebridge:cinebridge@recomendacoes-db:5432/recomendacoes
RABBITMQ_URL=amqp://guest:guest@cinebridge-mq:5672
# Quanto a api espera a resposta dos outros serviços antes de responder 503.
RPC_TEMPO_LIMITE_MS=5000

# Provedores (Adapter): local, s3 ou gcs | stripe ou pagseguro | fila, interno ou linkedin.
ARMAZENAMENTO=local
ARMAZENAMENTO_DIR=armazenamento
PAGAMENTO=stripe
PROFISSIONAIS=fila

# Pilha de decoradores, de fora para dentro (auditoria, cache, compressao). Vazio desliga todos.
DECORADORES=auditoria,cache,compressao
NIVEL_COMPRESSAO=6
