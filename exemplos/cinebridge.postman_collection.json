          "raw": "{\n  \"tipo\": \"animacao\",\n  \"nome\": \"Curta de Animação\",\n  \"produtor\": \"estudio@exemplo.com\",\n  \"duracao\": 15,\n  \"orcamento\": 80000,\n  \"prazo\": \"2027-03-30\",\n  \"servico\": {\n    \"nome\": \"Curta de Animação\",\n    \"servicos\": [\n      {\n        \"nome\": \"Pré-produção\",\n        \"servicos\": [\n          {\n            \"nome\": \"Direção e storyboard\",\n            \"papel\": \"DIRETOR\",\n            \"custo\": 18000,\n            \"prazo\": \"2026-12-15\",\n            \"competencias\": [\n              {\n                \"nome\": \"animacao\",\n                \"nivel\": 9\n              },\n              {\n                \"nome\": \"storyboard\",\n                \"nivel\": 8\n              }\n            ]\n          }\n        ]\n      },\n      {\n        \"nome\": \"Produção\",\n        \"servicos\": [\n          {\n            \"nome\": \"Modelagem 3D\",\n            \"papel\": \"EFEITOS_VISUAIS\",\n            \"custo\": 24000,\n            \"prazo\": \"2027-02-15\",\n            \"competencias\": [\n              {\n                \"nome\": \"modelagem 3d\",\n                \"nivel\": 9\n              },\n              {\n                \"nome\": \"blender\",\n                \"nivel\": 8\n              }\n            ]\n          }\n        ]\n      },\n      {\n        \"nome\": \"Pós-produção\",\n        \"servicos\": [\n          {\n            \"nome\": \"Montagem\",\n            \"papel\": \"EDITOR\",\n            \"custo\": 6000,\n            \"prazo\": \"2027-03-20\"\n          },\n          {\n            \"nome\": \"Som\",\n            \"servicos\": [\n              {\n                \"nome\": \"Foley\",\n                \"papel\": \"SONOPLASTA\",\n                \"custo\": 3000,\n                \"prazo\": \"2027-03-10\",\n                \"competencias\": [\n                  {\n                    \"nome\": \"foley\",\n                    \"nivel\": 7\n                  }\n                ]\n              },\n              {\n                \"nome\": \"Mixagem\",\n                \"papel\": \"SONOPLASTA\",\n                \"custo\": 3000,\n                \"prazo\": \"2027-03-25\",\n                \"competencias\": [\n                  {\n                    \"nome\": \"mixagem\",\n                    \"nivel\": 8\n                  }\n                ]\n              }\n            ]\n          }\n        ]\n      }\n    ]\n  },\n  \"detalhes\": {\n    \"tecnica\": \"3d\",\n    \"quadrosPorSegundo\": 24\n  }\n}",
